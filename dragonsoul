local function getNearestMap(position)
    local closestIndex = nil
    local shortestDist = math.huge

    for index, mapData in ipairs(MapLocations) do
        local dist = (position - mapData.Position).Magnitude
        if dist < shortestDist and dist <= MAX_MAP_SNAP_DISTANCE then
            shortestDist = dist
            closestIndex = index
        end
    end

    return closestIndex, closestIndex and MapLocations[closestIndex] or nil
end

local function getOrCreateMapMarker(mapIndex)
    if activeMapMarkers[mapIndex] then
        return activeMapMarkers[mapIndex]
    end

    local mapData = MapLocations[mapIndex]
    if not mapData then return nil end

    local anchorPart = Instance.new("Part")
    anchorPart.Name = "ActiveMapAnchor_" .. mapData.Name
    anchorPart.Size = Vector3.new(1, 1, 1)
    anchorPart.Position = mapData.Position + Vector3.new(0, 60, 0)
    anchorPart.Anchored = true
    anchorPart.CanCollide = false
    anchorPart.Transparency = 1
    anchorPart.Parent = visualFolder

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ActiveMapESP_" .. mapData.Name
    billboard.Size = UDim2.new(0, 170, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 25, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = espEnabled
    billboard.Adornee = anchorPart
    billboard.Parent = visualFolder

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = mapData.Name
    textLabel.TextColor3 = Color3.fromRGB(0, 210, 255)
    textLabel.TextStrokeTransparency = 0.3
    textLabel.TextSize = 14
    textLabel.Font = Enum.Font.GothamBold
    textLabel.Parent = billboard

    local marker = {
        Name = mapData.Name,
        Position = mapData.Position,
        Part = anchorPart,
        Billboard = billboard,
        TextLabel = textLabel
    }
    activeMapMarkers[mapIndex] = marker
    return marker
end

local function destroyMapMarker(mapIndex)
    local marker = activeMapMarkers[mapIndex]
    if marker then
        if marker.Billboard then marker.Billboard:Destroy() end
        if marker.Part then marker.Part:Destroy() end
        activeMapMarkers[mapIndex] = nil
    end
end

local function destroyAllMapMarkers()
    for mapIndex in pairs(activeMapMarkers) do
        destroyMapMarker(mapIndex)
    end
end

local function getTargetPart(obj)
    if obj:IsA("BasePart") then
        return obj
    elseif obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function isStaticMapOrQuestProp(obj)
    local fullPath = obj:GetFullName():lower()
    local blockedKeywords = {
        "quest", "npc", "shop", "deco", "decoration", "prop",
        "building", "capsule", "radar", "display", "fake", "statue", "pedestal",
        "shenron", "altar", "shrine", "lobby", "spawn", "terrain", "world", "map",
        "assets", "architecture", "structures", "effects", "vfx"
    }

    local isExplicitSpawnFolder = fullPath:find("dragonballspawns", 1, true)
        or fullPath:find("dragonballs", 1, true)
        or fullPath:find("itemspawns", 1, true)
        or fullPath:find("drops", 1, true)

    if not isExplicitSpawnFolder then
        for _, word in ipairs(blockedKeywords) do
            if fullPath:find(word, 1, true) then
                return true
            end
        end
    end

    local hasTrigger = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
        or obj:FindFirstChildWhichIsA("ClickDetector", true)
        or obj:FindFirstChildWhichIsA("TouchTransmitter", true)

    if not hasTrigger and obj.Parent and obj.Parent ~= Workspace then
        hasTrigger = obj.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
            or obj.Parent:FindFirstChildWhichIsA("ClickDetector", true)
            or obj.Parent:FindFirstChildWhichIsA("TouchTransmitter", true)
    end

    return not hasTrigger
end

local function isValidDragonBall(obj)
    if not obj or not obj.Parent then return false end
    if blacklistedInstances[obj] then return false end
    if not obj:IsDescendantOf(Workspace) then return false end
    if not obj:IsA("Model") and not obj:IsA("BasePart") then return false end
    if Players:GetPlayerFromCharacter(obj) or obj:IsDescendantOf(Workspace.CurrentCamera) then
        return false
    end

    if obj:FindFirstAncestorOfClass("Tool") or obj:FindFirstAncestorOfClass("Accessory") then
        return false
    end
    local ancestorModel = obj:FindFirstAncestorOfClass("Model")
    if ancestorModel and ancestorModel:FindFirstChildOfClass("Humanoid") then
        return false
    end

    local lowerName = obj.Name:lower()
    if lowerName:find("dragonball") == nil and lowerName:find("dragon ball") == nil then
        return false
    end

    local targetPart = getTargetPart(obj)
    if not targetPart or targetPart.Position.Magnitude < 1 then
        return false
    end

    local pos = targetPart.Position
    for _, zone in ipairs(blacklistedPositions) do
        if (pos - zone.Pos).Magnitude < zone.Radius then
            return false
        end
    end

    if ignoreStaticProps and isStaticMapOrQuestProp(obj) then
        return false
    end

    return true
end

local function createESP(targetObj)
    if trackedBalls[targetObj] then return end
    if not isValidDragonBall(targetObj) then return end

    local targetPart = getTargetPart(targetObj)
    if not targetPart then return end

    local newPos = targetPart.Position

    -- Position de-duplication (< 8 studs)
    for _, existingData in pairs(trackedBalls) do
        if existingData.TargetPart and (existingData.TargetPart.Position - newPos).Magnitude < 8 then
            return
        end
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DragonBall_Tag"
    billboard.Size = UDim2.new(0, 140, 0, 45)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = espEnabled
    billboard.Adornee = targetPart
    billboard.Parent = visualFolder

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = "Dragon Ball"
    textLabel.TextColor3 = Color3.fromRGB(255, 140, 0)
    textLabel.TextStrokeTransparency = 0.3
    textLabel.TextSize = 14
    textLabel.Font = Enum.Font.GothamBold
    textLabel.Parent = billboard

    trackedBalls[targetObj] = {
        Billboard = billboard,
        TextLabel = textLabel,
        TargetPart = targetPart
    }

    local mapIndex = getNearestMap(newPos)
    if mapIndex then
        getOrCreateMapMarker(mapIndex)
    end
end

local function clearTrackedBalls()
    for _, data in pairs(trackedBalls) do
        if data.Billboard then data.Billboard:Destroy() end
    end
    table.clear(trackedBalls)
    destroyAllMapMarkers()
end

local function scanWorkspace()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isValidDragonBall(obj) then
            createESP(obj)
        end
    end
end

