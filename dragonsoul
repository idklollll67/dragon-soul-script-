-- Frame Update Loop
local lastStatusText = ""
local renderConn = RunService.RenderStepped:Connect(function()
    local character = localPlayer.Character
    local root = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head"))
    local originPos = root and root.Position

    local neededMapCounts = {}
    local statusLines = {}

    for obj, data in pairs(trackedBalls) do
        if not isValidDragonBall(obj) then
            if data.Billboard then data.Billboard:Destroy() end
            trackedBalls[obj] = nil
        else
            if not data.TargetPart or not data.TargetPart.Parent then
                data.TargetPart = getTargetPart(obj)
                if data.TargetPart then data.Billboard.Adornee = data.TargetPart end
            end

            local targetPart = data.TargetPart
            if targetPart and targetPart:IsDescendantOf(Workspace) and targetPart.Position.Magnitude >= 1 then
                data.Billboard.Enabled = espEnabled

                if espEnabled then
                    local ballPos = targetPart.Position
                    local nearestIndex, nearestMap = getNearestMap(ballPos)

                    if nearestIndex then
                        neededMapCounts[nearestIndex] = (neededMapCounts[nearestIndex] or 0) + 1
                    end

                    local distToPlayer = originPos and math.floor((ballPos - originPos).Magnitude) or 0
                    data.TextLabel.Text = string.format("Dragon Ball\n[%d studs]", distToPlayer)

                    local parentName = obj.Parent and obj.Parent.Name or "Workspace"
                    table.insert(statusLines, string.format(
                        "• %s (in %s) near %s [%d, %d, %d]",
                        obj.Name,
                        parentName,
                        nearestMap and nearestMap.Name or "Out of Range",
                        math.floor(ballPos.X),
                        math.floor(ballPos.Y),
                        math.floor(ballPos.Z)
                    ))
                end
            else
                data.Billboard.Enabled = false
            end
        end
    end

    local newStatusText = (#statusLines > 0) and table.concat(statusLines, "\n") or "No active Dragon Balls detected."
    if newStatusText ~= lastStatusText then
        lastStatusText = newStatusText
        pcall(function()
            StatusParagraph:SetDesc(newStatusText)
        end)
    end

    if espEnabled then
        for mapIndex, count in pairs(neededMapCounts) do
            local marker = getOrCreateMapMarker(mapIndex)
            if marker then
                marker.Billboard.Enabled = true
                local distToMap = originPos and math.floor((marker.Position - originPos).Magnitude) or 0
                marker.TextLabel.Text = string.format("%s (%d DB)\n[%d studs]", marker.Name, count, distToMap)
            end
        end

        for mapIndex in pairs(activeMapMarkers) do
            if not neededMapCounts[mapIndex] then
                destroyMapMarker(mapIndex)
            end
        end
    else
        destroyAllMapMarkers()
    end
end)
table.insert(connections, renderConn)

-- Detect newly spawned DragonBalls instantly
